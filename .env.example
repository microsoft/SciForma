# SciForma Agent — local Azure CLI configuration
# Copy this file to .env. Never commit .env or the endpoint configuration.

# Python file containing endpoint_token_provider_dict. Keep this file outside
# the SciForma repository; only its absolute path belongs here.
SCIFORMA_AZURE_CONFIG_PATH=/absolute/path/to/azure_endpoint_config.py
SCIFORMA_AZURE_ENDPOINT_INDEX=0

# GPT-5.4 is recommended and is the deployment validated by this project.
# VISION_MODEL must accept images for AI Review and multi-round YOLO refinement.
LLM_MODEL=gpt-5.4
VISION_MODEL=gpt-5.4

# Only needed when an Azure deployment alias cannot be inferred from its name.
# SCIFORMA_MAX_TOKENS_PARAM=max_completion_tokens
# SCIFORMA_SEND_TEMPERATURE=never

# Do not store HF_TOKEN here. Export it temporarily only while running
# generate/prepare_ui_models.py, then unset it.
